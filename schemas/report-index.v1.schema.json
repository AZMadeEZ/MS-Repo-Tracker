{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MS Repo Tracker Report Index",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_version",
    "schema_url",
    "generated_at",
    "daily"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "tracker-report-index"
    },
    "artifact_version": {
      "type": "string"
    },
    "schema_url": {
      "const": "schemas/report-index.v1.schema.json"
    },
    "generated_at": {
      "type": "string"
    },
    "daily": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
