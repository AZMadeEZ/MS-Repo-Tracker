{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MS Repo Tracker Run Status",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_version",
    "schema_url",
    "generated_at",
    "last_attempt_at",
    "status",
    "reason",
    "latest_report_stale",
    "freshness"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "tracker-status"
    },
    "artifact_version": {
      "type": "string"
    },
    "schema_url": {
      "const": "schemas/status.v1.schema.json"
    },
    "generated_at": {
      "type": "string"
    },
    "last_attempt_at": {
      "type": "string"
    },
    "last_success_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "deferred",
        "failed"
      ]
    },
    "reason": {
      "type": "string"
    },
    "latest_report_generated_at": {
      "type": "string"
    },
    "latest_report_stale": {
      "type": "boolean"
    },
    "freshness": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
