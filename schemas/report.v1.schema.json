{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MS Repo Tracker Report",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_version",
    "schema_url",
    "generated_at",
    "window",
    "totals",
    "summaries",
    "event_stream",
    "activities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "tracker-report"
    },
    "artifact_version": {
      "type": "string"
    },
    "schema_url": {
      "const": "schemas/report.v1.schema.json"
    },
    "generated_at": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "window": {
      "type": "object",
      "required": [
        "since",
        "until",
        "hours_requested",
        "state_window_enabled"
      ],
      "properties": {
        "since": {
          "type": "string"
        },
        "until": {
          "type": "string"
        },
        "hours_requested": {
          "type": "integer"
        },
        "state_window_enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "totals": {
      "type": "object"
    },
    "summaries": {
      "type": "object"
    },
    "event_stream": {
      "type": "object",
      "required": [
        "schema_url",
        "latest_path",
        "dated_path",
        "event_count",
        "commit_event_count"
      ],
      "properties": {
        "schema_url": {
          "const": "schemas/event.v1.schema.json"
        },
        "latest_path": {
          "type": "string"
        },
        "dated_path": {
          "type": "string"
        },
        "event_count": {
          "type": "integer"
        },
        "commit_event_count": {
          "type": "integer"
        },
        "release_event_count": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "notable_changes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "product_area_summary": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "top_links": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "noise_summary": {
      "type": "object"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
